<!doctype html>
<html lang="en" class="scroll-smooth" translate="no">
	<head>
		<!-- Instant Theme Mode Pre-Hydration & App Version Auto-Upgrade Boot Script -->
		<script is:inline>
			(function() {
				try {
					var TARGET_BUILD_VERSION = "2.5.0";
					var storedBuildVersion = localStorage.getItem('app_build_version') || localStorage.getItem('app_version');
					if (storedBuildVersion !== TARGET_BUILD_VERSION) {
						localStorage.setItem('app_build_version', TARGET_BUILD_VERSION);
						localStorage.setItem('app_version', TARGET_BUILD_VERSION);
						// Force UI cache purge for old and returning users
						if ('caches' in window) {
							caches.keys().then(function(names) {
								for (var i = 0; i < names.length; i++) {
									caches.delete(names[i]);
								}
							});
						}
						if (storedBuildVersion) {
							window.location.reload();
							return;
						}
					}
					var savedTheme = localStorage.getItem('bm_theme');
					if (savedTheme === 'dark') {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
				} catch (e) {}
			})();
		</script>
