---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Brahmacharya Mitra — Celibacy, NoFap & Semen Retention Tracker",
	description = "Overcome porn addiction, brain fog, and relapse cycles with Brahmacharya Mitra. Track your celibacy & NoFap streak, master semen retention, and transmute energy."
} = Astro.props;

const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
const ogImage = `${baseUrl}photo_mahadev.jpg`;
const canonicalUrl = "https://bantymallick88-cell.github.io/brahmacharya-mitra/";
---

<!doctype html>
<html lang="en" class="dark scroll-smooth" translate="no">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/jpeg" href={`${baseUrl}photo_mahadev.jpg`} />
		<link rel="shortcut icon" href={`${baseUrl}photo_mahadev.jpg`} />
		<link rel="apple-touch-icon" href={`${baseUrl}photo_mahadev.jpg`} />
		<link rel="manifest" href={`${baseUrl}manifest.json`} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content="brahmacharya, celibacy, nofap, porn addiction recovery, semen retention tracker, dopamine detox, brain fog recovery, ojas transmutation, quit porn, streak counter" />
		<meta name="author" content="Brahmacharya Mitra" />
		<meta name="theme-color" content="#02040a" />

		<!-- Google Analytics Tag (GA4) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-XXXXXXXXXX');
		</script>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImage} />

		<!-- Google FAQPage JSON-LD Structured Data for Rich Results -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "What is Brahmacharya Mitra and how does it help with NoFap and Celibacy?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Brahmacharya Mitra (ब्रह्मचर्य मित्र) is a holistic spiritual-scientific platform engineered to help sadhaks break free from porn addiction, master celibacy, and sustain long-term semen retention. It features a reactive real-time streak timer, emergency Urge Breaker (Panic Mode) with 4-7-8 breathwork, daily habit transformation tracking, relapse cost diagnostics, and timeless Vedic scriptures backed by modern dopamine neuroscience."
					}
				},
				{
					"@type": "Question",
					"name": "How does practicing celibacy and quitting porn cure Brain Fog and Dopamine Burnout?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "High-frequency ejaculation coupled with pixelated pornography floods the brain's reward center, desensitizing dopamine D2 receptors and sparking neuroinflammation in the prefrontal cortex—the core cause of brain fog, lethargy, and anhedonia. Abstaining from digital stimulation and conserving seminal vital fluid initiates neuroplastic reversal: dopamine receptors upregulate, cognitive clarity returns, and vital fluids are transmuted into Ojas (mental brilliance and radiant aura) within 30 to 90 days."
					}
				},
				{
					"@type": "Question",
					"name": "What is the difference between Semen Retention, NoFap, and Brahmacharya?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "While 'NoFap' focuses primarily on abstaining from internet pornography and compulsive masturbation (PMO reboot), 'Semen Retention' is the physical practice of conserving seminal fluid to boost vitality, androgen sensitivity, and stamina. 'Brahmacharya' is the supreme Sanatan discipline: it transcends mere physical retention to encompass mind control, sensory mastery, pure speech, and the conscious upward transmutation of sexual energy (Virya) into spiritual potency (Ojas and Tejas)."
					}
				},
				{
					"@type": "Question",
					"name": "How do I install the Brahmacharya Mitra app on my phone Home Screen?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Brahmacharya Mitra is a full-featured Progressive Web App (PWA). On Android (Chrome or Edge), tap the 'Add to Home Screen' or 'Install App' banner at the bottom or from the top-right menu (☰) to trigger the native 1-tap install prompt. On iPhone/iPad (Safari), tap the 'Share' icon (square with upward arrow), scroll down, and select 'Add to Home Screen' (➕). Once installed, it launches fullscreen with offline support."
					}
				},
				{
					"@type": "Question",
					"name": "How do I restart my celibacy streak after a relapse?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "A relapse is an isolated setback, not the erasure of your neurological healing. First, guard against the 'chaser effect' (repeated binges) and take an immediate cold shower. In Brahmacharya Mitra, open the Streak Counter, reset your counter honestly, and log the trigger in your Journal notes. Remember: the physical resilience and neuroplastic upgrades earned during your previous clean days remain within you—forgive yourself and rise with renewed dedication."
					}
				},
				{
					"@type": "Question",
					"name": "What are the best recommended books to quit porn addiction and master mind control?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Our curated foundational literature comprises: 1) 'Brahmacharya: Kab, Kyon Aur Kaise?' by Shri Hit Premanand Ji Maharaj; 2) 'The Practice of Brahmacharya' by Swami Sivananda; 3) 'Your Brain on Porn' by Gary Wilson; 4) 'Divya Prerana Prakash' by Sant Shri Asharamji Bapu; 5) 'The Coiled Serpent' by C.J. Van Vliet; and 6) 'Brahmacharya Sandesh' by Swami Dayanand Saraswati. You can review all 6 with direct affiliate study links in our Books section."
					}
				}
			]
		})} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Rozha+One&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-[#02040a] text-zinc-100 min-h-screen selection:bg-amber-400 selection:text-black overflow-x-hidden antialiased w-full max-w-full relative">
		<!-- Mystic Deep Cosmic Purple & Indigo Aura Glow Mesh (21st.dev / Godly aesthetic) -->
		<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden w-full max-w-full">
			<!-- Top Navbar & Hero Aura: Deep Cosmic Purple & Indigo Aura -->
			<div class="absolute -top-36 left-1/2 -translate-x-1/2 w-[1200px] max-w-none h-[700px] bg-[radial-gradient(ellipse_at_center,rgba(109,40,217,0.22)_0%,rgba(99,102,241,0.18)_40%,rgba(245,158,11,0.12)_65%,transparent_80%)] blur-[100px] rounded-full pointer-events-none animate-aura-pulse"></div>
			
			<!-- Mid-Left Mystic Cosmic Purple Halo -->
			<div class="absolute top-[30%] -left-48 w-[800px] h-[800px] bg-[radial-gradient(circle,rgba(109,40,217,0.22)_0%,rgba(99,102,241,0.14)_50%,transparent_75%)] blur-[130px] rounded-full pointer-events-none"></div>
			
			<!-- Mid-Right Electric Gold & Indigo Fusion Pulse -->
			<div class="absolute top-[52%] -right-48 w-[800px] h-[800px] bg-[radial-gradient(circle,rgba(99,102,241,0.18)_0%,rgba(245,158,11,0.15)_45%,transparent_75%)] blur-[130px] rounded-full pointer-events-none"></div>

			<!-- Deity & Reboot Section: Warm Sunrise Amber Rising Glow -->
			<div class="absolute top-[60%] left-1/2 -translate-x-1/2 w-[1400px] max-w-none h-[600px] bg-[radial-gradient(ellipse_at_50%_80%,rgba(245,158,11,0.13)_0%,rgba(217,119,6,0.08)_40%,rgba(109,40,217,0.07)_65%,transparent_85%)] blur-[90px] rounded-full pointer-events-none animate-aura-pulse"></div>

			<!-- Lower Deities & Footer Cosmic Purple Depth Aura -->
			<div class="absolute top-[75%] left-1/3 w-[900px] h-[900px] bg-[radial-gradient(circle,rgba(109,40,217,0.22)_0%,rgba(99,102,241,0.12)_45%,transparent_75%)] blur-[150px] rounded-full pointer-events-none"></div>

			<!-- Horizon sunrise line glow — deep bottom atmospheric depth -->
			<div class="absolute bottom-0 left-0 right-0 h-[3px] bg-[linear-gradient(90deg,transparent_0%,rgba(245,158,11,0.25)_30%,rgba(251,191,36,0.4)_50%,rgba(245,158,11,0.25)_70%,transparent_100%)] blur-[2px] pointer-events-none"></div>
			
			<!-- Ultra-refined Tech-Grid texture -->
			<div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff04_1px,transparent_1px),linear-gradient(to_bottom,#ffffff04_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_80%_60%_at_50%_0%,#000_80%,transparent_100%)]"></div>
		</div>

		<div class="relative z-10 flex flex-col min-h-screen w-full max-w-full overflow-x-hidden">
			<slot />
		</div>
	</body>
</html>
