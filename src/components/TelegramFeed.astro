---
import fs from 'node:fs';
import path from 'node:path';
import TelegramFeedComponent from './TelegramFeed';

let rawData = [];
try {
  const filePath = path.resolve('./public/data/telegram_feed.json');
  if (fs.existsSync(filePath)) {
    rawData = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
  }
} catch (e) {
  console.error(e);
}
---
<TelegramFeedComponent client:only="react" initialPosts={rawData} />
