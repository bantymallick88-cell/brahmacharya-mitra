---
import fs from 'node:fs';
import path from 'node:path';
import TelegramFeedComponent from './TelegramFeed.tsx';
import { cleanFeedText } from '../utils/textCleaner';

// Directly parse and bind the complete array from public/data/telegram_feed.json (all 1441 reels)
const feedFilePath = path.resolve('./public/data/telegram_feed.json');
let allReels: any[] = [];
if (fs.existsSync(feedFilePath)) {
  try {
    const rawData = JSON.parse(fs.readFileSync(feedFilePath, 'utf-8'));
    allReels = rawData.map((item: any, idx: number) => ({
      telegram_message_id: item.telegram_message_id || idx + 1,
      group_id: item.group_id || -1003536137330,
      topic_id: item.topic_id || 14,
      content_type: 'video',
      media_url: item.media_url || item.video_url || item.file_path || '',
      video_url: item.video_url || item.media_url || item.file_path || '',
      file_path: item.file_path || item.video_url || item.media_url || '',
      text_content: cleanFeedText(item.text_content || ''),
      author_name: cleanFeedText(item.author_name || 'Sadhak Brotherhood'),
      timestamp: item.timestamp || new Date().toISOString(),
      likes: item.likes || ((idx * 17) % 3800 + 450),
      shares: item.shares || ((idx * 7) % 950 + 80),
      tags: Array.isArray(item.tags) ? item.tags.map(cleanFeedText) : ['#Brahmacharya', '#Ojas'],
    }));
  } catch (e) {
    console.error('Error reading telegram_feed.json in TelegramFeed.astro:', e);
  }
}
---

<section id="reels" class="w-full py-8 sm:py-14 relative overflow-hidden bg-black text-zinc-100">
  {/* Ambient glowing radial backdrop */}
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(245,158,11,0.08)_0%,rgba(109,40,217,0.1)_40%,transparent_70%)] rounded-full blur-[140px] pointer-events-none"></div>

  <TelegramFeedComponent client:load initialPosts={allReels} />
</section>

