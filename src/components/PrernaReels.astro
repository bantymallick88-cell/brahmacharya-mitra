---
// Brahmacharya Prerna Reels - Native Swipable Reel Player
---

<section id="reels" class="flex flex-col items-center justify-center py-12 sm:py-20 bg-[#02040a] text-white select-none relative overflow-hidden">
  
  {/* Ambient Cosmic Purple & Amber Glow */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-[radial-gradient(circle,rgba(245,158,11,0.12)_0%,rgba(109,40,217,0.14)_45%,transparent_70%)] blur-3xl pointer-events-none -z-10"></div>

  <!-- Title Header -->
  <div class="text-center mb-6 px-4">
    <span class="bg-amber-500/20 text-amber-400 text-xs font-semibold px-3 py-1 rounded-full border border-amber-500/30 uppercase tracking-wider inline-block shadow-[0_0_15px_rgba(245,158,11,0.15)]">
      ✨ VEDIC SHORTS & DAILY INSPIRATION
    </span>
    <h2 class="text-3xl sm:text-4xl font-extrabold mt-3 tracking-wide text-amber-100 font-cinzel">
      BRAHMACHARYA PRERNA REELS
    </h2>
    <p class="text-xs text-zinc-400 mt-2 max-w-md mx-auto">
      Swipe vertically to explore daily reels, celibacy reminders & masculine vitality clips.
    </p>
  </div>

  <!-- Outer Glow Frame Wrapper -->
  <div class="relative group px-4">
    <div class="absolute -inset-1.5 bg-gradient-to-b from-amber-500/25 via-indigo-500/15 to-amber-500/25 rounded-[2.5rem] blur-lg opacity-70 group-hover:opacity-100 transition duration-500 pointer-events-none"></div>

    <!-- Swipable Reel Player Container -->
    <div id="reel-player-container" class="w-[320px] xs:w-[360px] h-[640px] bg-zinc-950 rounded-3xl overflow-y-scroll snap-y snap-mandatory border border-zinc-800 shadow-[0_0_50px_rgba(0,0,0,0.9),0_0_30px_rgba(245,158,11,0.15)] relative no-scrollbar">
      
      <!-- Reel Item 1 -->
      <div class="snap-start w-full h-full relative flex items-center justify-center bg-black shrink-0">
        <video 
          class="w-full h-full object-cover rounded-3xl reel-video" 
          controls 
          loop 
          playsinline
          preload="metadata"
          poster="photo_mahadev.jpg"
        >
          <source src="https://example.com/reel1.mp4" type="video/mp4" />
        </video>
        
        <!-- Bottom Info Overlay -->
        <div class="absolute bottom-6 left-4 right-4 flex justify-between items-end z-10 pointer-events-none">
          <div class="pointer-events-auto bg-black/60 backdrop-blur-md p-3.5 rounded-2xl border border-white/10 w-full shadow-lg">
            <div class="flex items-center justify-between">
              <p class="text-sm font-bold text-amber-400">@brahmacharyahelp</p>
              <span class="text-[10px] text-zinc-400 uppercase tracking-widest font-mono">Reel 1</span>
            </div>
            <p class="text-xs text-zinc-200 mt-1 font-medium">Akhand Brahmacharya Power & Tapasya 🔥</p>
          </div>
        </div>
      </div>

      <!-- Reel Item 2 -->
      <div class="snap-start w-full h-full relative flex items-center justify-center bg-black shrink-0">
        <video 
          class="w-full h-full object-cover rounded-3xl reel-video" 
          controls 
          loop 
          playsinline
          preload="metadata"
          poster="photo_mahadev.jpg"
        >
          <source src="https://example.com/reel2.mp4" type="video/mp4" />
        </video>
        
        <!-- Bottom Info Overlay -->
        <div class="absolute bottom-6 left-4 right-4 flex justify-between items-end z-10 pointer-events-none">
          <div class="pointer-events-auto bg-black/60 backdrop-blur-md p-3.5 rounded-2xl border border-white/10 w-full shadow-lg">
            <div class="flex items-center justify-between">
              <p class="text-sm font-bold text-amber-400">@brahmacharyahelp</p>
              <span class="text-[10px] text-zinc-400 uppercase tracking-widest font-mono">Reel 2</span>
            </div>
            <p class="text-xs text-zinc-200 mt-1 font-medium">Daily Discipline Motivation 🙏</p>
          </div>
        </div>
      </div>

      <!-- Reel Item 3 (Easy template to add more reels) -->
