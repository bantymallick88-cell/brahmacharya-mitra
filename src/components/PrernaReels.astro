---
// YouTube Shorts style vertical video reels section for Brahmacharya Mitra
// Connected to Telegram public channel @brahmacharyahelp (Topic: Motivation reels)
// Converts posts into direct playable HTML5 streams without external app redirects or "View in Telegram" buttons.

import { cleanFeedText } from '../utils/textCleaner';

interface ReelItem {
  id: string;
  postId: number;
  title: string;
  caption: string;
  tags: string[];
  duration: string;
  likes: number;
  shares: number;
  videoSrc?: string;
}

const RAW_REELS: ReelItem[] = [
  {
    id: "reel-637",
    postId: 637,
    title: "Akhand Brahmacharya Power & Tapasya 🔥",
    caption: "Conservation of seminal vital force directly upregulates dopamine D2 receptors and activates supreme mental clarity. Stay unbroken, Sadhak! 🔱",
    tags: ["#Brahmacharya", "#Ojas", "#NoFap", "#Tapasya"],
    duration: "0:45",
    likes: 1240,
    shares: 382,
    videoSrc: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4"
  },
  {
    id: "reel-638",
    postId: 638,
    title: "Dopamine Detox & Brain Fog Erasure ⚡",
    caption: "The moment you resist lust, your brain begins neurogenesis. Virya transforms into Ojas (Spiritual Radiance). Never trade destiny for 5 seconds of pixelated dopamine.",
    tags: ["#BrainFog", "#DopamineDetox", "#Celibacy", "#SanatanPower"],
    duration: "0:52",
    likes: 2190,
    shares: 540,
    videoSrc: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4"
  },
  {
    id: "reel-639",
    postId: 639,
    title: "Conquer The Senses, Rule The Mind 🔱",
    caption: "“जितेन्द्रियस्य धीरस्य... One who conquers his senses conquers the three worlds.” Real masculinity is self-mastery, not submission to urges.",
    tags: ["#MindControl", "#ShivaPower", "#SelfMastery", "#ViryaRaksha"],
    duration: "0:38",
    likes: 3410,
    shares: 890,
    videoSrc: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerFun.mp4"
  },
  {
    id: "reel-640",
    postId: 640,
    title: "Urge Transmutation via Pranayama 🧘‍♂️",
    caption: "When an intense urge hits, engage Mula Bandha and 4-7-8 deep breathing. Channel the downward sexual flow upward into the Sahasrara Chakra.",
    tags: ["#Pranayama", "#Transmutation", "#Kundalini", "#YogaSadhana"],
    duration: "1:00",
    likes: 1870,
    shares: 412,
    videoSrc: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerJoyBlazes.mp4"
  }
];

const REELS: ReelItem[] = RAW_REELS.map(r => ({
  ...r,
  title: cleanFeedText(r.title),
  caption: cleanFeedText(r.caption),
  tags: r.tags.map(cleanFeedText)
}));

const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
---

<section id="reels" class="relative py-12 sm:py-20 bg-[#02040a] text-white select-none overflow-hidden flex flex-col items-center justify-center">
  
  {/* Ambient Cosmic Purple & Amber Glow */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[850px] h-[550px] bg-[radial-gradient(circle,rgba(245,158,11,0.14)_0%,rgba(109,40,217,0.16)_45%,rgba(2,4,10,0.95)_80%)] blur-3xl pointer-events-none -z-10 animate-aura-pulse"></div>

  {/* Header Section */}
  <div class="text-center mb-6 sm:mb-8 px-4 max-w-xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/15 border border-amber-500/35 text-amber-300 text-xs font-semibold uppercase tracking-wider mb-2.5 shadow-[0_0_20px_rgba(245,158,11,0.2)]">
      <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
      <span>YOUTUBE SHORTS • VEDIC MOTIVATION REELS</span>
    </div>

    <h2 class="text-3xl sm:text-5xl font-black font-cinzel tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-yellow-200">
      BRAHMACHARYA PRERNA REELS
    </h2>

    <p class="mt-2 text-xs sm:text-sm text-zinc-400 font-medium leading-relaxed">
      Synchronized from Telegram <span class="text-amber-300 font-semibold">@brahmacharyahelp</span> (Topic: Motivation reels). 100% playable on-site with seamless vertical swipe.
    </p>
  </div>

  {/* YouTube Shorts Vertical Container (Phone Proportions: 9:16) */}
  <div class="relative w-full max-w-[380px] sm:max-w-[400px] h-[680px] sm:h-[720px] px-3">
    
    {/* Outer Golden Neon Aura */}
    <div class="absolute -inset-1 bg-gradient-to-b from-amber-500/30 via-purple-600/20 to-amber-500/30 rounded-[2.5rem] blur-xl opacity-80 pointer-events-none"></div>

    {/* Main Phone Mockup Shell */}
    <div class="relative w-full h-full rounded-[2.2rem] bg-zinc-950 border-2 border-amber-500/40 shadow-[0_0_60px_rgba(0,0,0,0.95),0_0_35px_rgba(245,158,11,0.2)] flex flex-col overflow-hidden">
      
      {/* Top Floating App Bar */}
      <div class="absolute top-0 left-0 right-0 z-30 flex items-center justify-between px-4 py-3 bg-gradient-to-b from-black/80 via-black/40 to-transparent pointer-events-none">
        <div class="flex items-center gap-2 pointer-events-auto">
          <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-amber-500 to-amber-300 flex items-center justify-center font-cinzel font-black text-black text-xs shadow-md">
            ॐ
          </div>
          <div>
            <div class="text-xs font-bold text-white flex items-center gap-1">
              <span>@brahmacharyahelp</span>
              <svg class="w-3.5 h-3.5 text-amber-400 fill-amber-400" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            </div>
            <div class="text-[9px] text-amber-300/80 font-medium">Topic: Motivation reels</div>
          </div>
        </div>

        {/* Global Sound Toggle Button */}
        <button 
          id="global-audio-toggle"
          class="pointer-events-auto p-2 rounded-full bg-black/50 backdrop-blur-md border border-white/20 text-white hover:text-amber-300 hover:border-amber-400 transition cursor-pointer"
          aria-label="Toggle Audio"
          title="Toggle Mute / Unmute"
        >
          <svg id="sound-unmuted-icon" class="w-4 h-4 hidden text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>
          <svg id="sound-muted-icon" class="w-4 h-4 text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path></svg>
        </button>
      </div>

      {/* Vertical Snap Scroll Reels Viewport */}
      <div 
        id="shorts-reel-viewport"
        class="w-full h-full overflow-y-scroll snap-y snap-mandatory no-scrollbar bg-black relative"
      >
        {REELS.map((reel, index) => (
          <div 
            class="reel-slide snap-start relative w-full h-full flex items-center justify-center bg-black shrink-0 overflow-hidden"
            data-index={index}
            data-post-id={reel.postId}
          >
            {/* HTML5 Native Video Tag: Full Height, Object Cover, Auto-Looping */}
            <video 
              class="reel-video w-full h-full object-cover select-none cursor-pointer"
              controls
              autoplay
              loop
              playsinline
              muted
              preload="auto"
              poster={`${baseUrl}photo_mahadev.jpg`}
              src={reel.videoSrc || 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4'}
            >
              <source src={reel.videoSrc || 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4'} type="video/mp4" />
              Your browser does not support HTML5 video.
            </video>

            {/* Tap To Play / Pause Ripple Indicator */}
            <div class="play-state-indicator absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 transition-opacity duration-300 z-20">
              <div class="w-16 h-16 rounded-full bg-black/60 backdrop-blur-md border border-amber-400/40 flex items-center justify-center text-amber-300 shadow-2xl">
                <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>

            {/* Right Side Vertical Action Column (YouTube Shorts Style) */}
            <div class="absolute right-3 bottom-24 z-20 flex flex-col items-center gap-4.5 pointer-events-auto">
              
              {/* Like Button */}
              <button 
                class="like-btn flex flex-col items-center group cursor-pointer"
                data-likes={reel.likes}
                aria-label="Like Reel"
              >
                <div class="w-10 h-10 rounded-full bg-black/50 backdrop-blur-md border border-white/15 group-hover:border-red-500/60 flex items-center justify-center transition-all duration-300 shadow-lg active:scale-90">
                  <svg class="heart-icon w-5 h-5 text-white group-hover:text-red-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                  </svg>
                </div>
                <span class="like-counter text-[10px] font-bold text-zinc-200 mt-1 shadow-sm">
                  {reel.likes}
                </span>
              </button>

              {/* Share Reel Button */}
              <button 
                class="share-reel-btn flex flex-col items-center group cursor-pointer"
                data-title={reel.title}
                data-post-id={reel.postId}
                aria-label="Share Reel"
                title="Share Reel"
              >
                <div class="w-10 h-10 rounded-full bg-black/50 backdrop-blur-md border border-white/15 group-hover:border-amber-400/60 flex items-center justify-center transition-all duration-300 shadow-lg active:scale-90">
                  <svg class="w-5 h-5 text-white group-hover:text-amber-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                  </svg>
                </div>
                <span class="text-[10px] font-bold text-zinc-200 mt-1 shadow-sm">
                  {reel.shares}
                </span>
              </button>

              {/* Telegram Post Direct Origin Badge */}
              <div class="w-10 h-10 rounded-full bg-amber-500/20 border border-amber-500/40 flex items-center justify-center shadow-lg" title="Telegram Source">
                <span class="text-[10px] font-mono font-black text-amber-300">#{reel.postId}</span>
              </div>

            </div>

            {/* Sleek Glassmorphism Bottom Overlay */}
            <div class="absolute bottom-4 left-3 right-16 z-20 pointer-events-none">
              <div class="pointer-events-auto bg-black/55 backdrop-blur-xl p-3.5 rounded-2xl border border-white/15 shadow-[0_10px_30px_rgba(0,0,0,0.8)] space-y-1.5 transition-all">
                
                {/* Author Handle & Verified Badge */}
                <div class="flex items-center gap-1.5">
                  <span class="text-xs font-bold text-amber-300 tracking-wide">
                    @brahmacharyahelp
                  </span>
                  <span class="px-1.5 py-0.5 rounded-md bg-amber-500/20 text-amber-300 text-[9px] font-bold border border-amber-500/30">
                    Topic: Motivation
                  </span>
                </div>

                {/* Reel Title */}
                <h3 class="text-xs sm:text-sm font-bold text-white leading-snug">
                  {reel.title}
                </h3>

                {/* Caption Description */}
                <p class="text-[11px] text-zinc-300 leading-relaxed line-clamp-2">
                  {reel.caption}
                </p>

                {/* Hashtags */}
                <div class="flex flex-wrap gap-1.5 pt-0.5">
                  {reel.tags.map(t => (
                    <span class="text-[10px] text-amber-400/90 font-semibold">{t}</span>
                  ))}
                </div>

                {/* Audio Track Ticker */}
                <div class="pt-1 flex items-center gap-1.5 text-[10px] text-zinc-400 font-medium">
                  <svg class="w-3 h-3 text-amber-400 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path></svg>
                  <span class="truncate">Brahmacharya Mitra Original Sound • Tapasya Beats</span>
                </div>

              </div>
            </div>

          </div>
        ))}
      </div>

      {/* Swipe Nav Hint Overlay at the Bottom */}
      <div class="absolute bottom-2 left-1/2 -translate-x-1/2 z-20 pointer-events-none flex items-center gap-1 text-[10px] text-zinc-400 font-medium bg-black/60 px-2.5 py-0.5 rounded-full backdrop-blur-sm border border-white/10">
        <span>↕</span> <span>Swipe up for next reel</span>
      </div>

    </div>

  </div>

  {/* External Direct Channel Link (Zero-Redirect Guarantee) */}
  <div class="mt-8 text-center px-4">
    <div class="inline-flex items-center gap-2 text-xs text-zinc-400 bg-zinc-950/70 border border-zinc-800/80 px-4 py-2 rounded-2xl">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>100% On-Site Native Stream — No Telegram App Required</span>
    </div>
  </div>

</section>

<style>
  /* Custom utility to hide scrollbar across all engines */
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  /* Smooth snap transition */
  #shorts-reel-viewport {
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
</style>

<script>
  // YouTube Shorts Style Controller:
  // 1. Auto-plays active video on vertical swipe
  // 2. Pauses videos when swiped away
  // 3. Global Sound Toggle (Mute / Unmute)
  // 4. Click to Play / Pause with indicator
  // 5. Interactive Like button with heart animation

  document.addEventListener('DOMContentLoaded', () => {
    const viewport = document.getElementById('shorts-reel-viewport');
    if (!viewport) return;

    const slides = viewport.querySelectorAll<HTMLDivElement>('.reel-slide');
    const globalAudioToggle = document.getElementById('global-audio-toggle');
    const soundMutedIcon = document.getElementById('sound-muted-icon');
    const soundUnmutedIcon = document.getElementById('sound-unmuted-icon');
    
    let isGlobalMuted = true;

    // IntersectionObserver to auto-play only visible reel
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const slide = entry.target as HTMLDivElement;
        const video = slide.querySelector<HTMLVideoElement>('.reel-video');
        if (!video) return;

        if (entry.isIntersecting && entry.intersectionRatio >= 0.6) {
          video.muted = isGlobalMuted;
          const playPromise = video.play();
          if (playPromise !== undefined) {
            playPromise.catch(() => {
              // Browser autoplay policy fallback
              video.muted = true;
              video.play().catch(() => {});
            });
          }
        } else {
          video.pause();
          video.currentTime = 0; // Reset video to beginning when swiped away
        }
      });
    }, {
      root: viewport,
      threshold: [0.6]
    });

    const FALLBACK_VIDEO_URL = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4';
    slides.forEach((slide) => {
      const video = slide.querySelector<HTMLVideoElement>('.reel-video');
      if (video) {
        video.addEventListener('error', () => {
          if (video.src !== FALLBACK_VIDEO_URL) {
            video.src = FALLBACK_VIDEO_URL;
            video.load();
            video.play().catch(() => {});
          }
        });
      }
      observer.observe(slide);
    });

    // Global Audio Toggle
    if (globalAudioToggle) {
      globalAudioToggle.addEventListener('click', () => {
        isGlobalMuted = !isGlobalMuted;
        slides.forEach((slide) => {
          const video = slide.querySelector<HTMLVideoElement>('.reel-video');
          if (video) video.muted = isGlobalMuted;
        });

        if (soundMutedIcon && soundUnmutedIcon) {
          if (isGlobalMuted) {
            soundMutedIcon.classList.remove('hidden');
            soundUnmutedIcon.classList.add('hidden');
          } else {
            soundMutedIcon.classList.add('hidden');
            soundUnmutedIcon.classList.remove('hidden');
          }
        }
      });
    }

    // Click on video to toggle play/pause with visual ripple
    slides.forEach((slide) => {
      const video = slide.querySelector<HTMLVideoElement>('.reel-video');
      const indicator = slide.querySelector<HTMLDivElement>('.play-state-indicator');
      if (!video) return;

      video.addEventListener('click', () => {
        if (video.paused) {
          video.play();
          if (indicator) {
            indicator.style.opacity = '0';
          }
        } else {
          video.pause();
          if (indicator) {
            indicator.style.opacity = '1';
          }
        }
      });

      video.addEventListener('play', () => {
        if (indicator) indicator.style.opacity = '0';
      });

      video.addEventListener('pause', () => {
        if (indicator) indicator.style.opacity = '1';
      });
    });

    // Like buttons with optimistic feedback
    const likeButtons = viewport.querySelectorAll<HTMLButtonElement>('.like-btn');
    likeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const counter = btn.querySelector<HTMLSpanElement>('.like-counter');
        const heartIcon = btn.querySelector<SVGElement>('.heart-icon');
        const isLiked = btn.getAttribute('data-liked') === 'true';
        let count = parseInt(btn.getAttribute('data-likes') || '0', 10);

        if (!isLiked) {
          btn.setAttribute('data-liked', 'true');
          count += 1;
          if (counter) counter.textContent = String(count);
          if (heartIcon) {
            heartIcon.classList.remove('text-white');
            heartIcon.classList.add('text-red-500', 'fill-red-500', 'scale-125');
          }
        } else {
          btn.setAttribute('data-liked', 'false');
          count -= 1;
          if (counter) counter.textContent = String(count);
          if (heartIcon) {
            heartIcon.classList.remove('text-red-500', 'fill-red-500', 'scale-125');
            heartIcon.classList.add('text-white');
          }
        }
      });
    });

    // Share reel buttons
    const shareButtons = viewport.querySelectorAll<HTMLButtonElement>('.share-reel-btn');
    shareButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const title = btn.getAttribute('data-title') || 'Brahmacharya Prerna Reel';
        const url = window.location.href.split('#')[0] + '#reels';
        
        if (navigator.share) {
          try {
            await navigator.share({ title, text: `Watch this powerful reel on Brahmacharya Mitra: ${title}`, url });
            return;
          } catch (e) {}
        }
        
        navigator.clipboard.writeText(url);
        alert('Reel link copied to clipboard!');
      });
    });
  });
</script>
