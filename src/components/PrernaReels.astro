---
// Brahmacharya Prerna Reels Section
// To add new reels, simply copy the reel block below and update the data-telegram-post number.
---

<section id="reels" class="py-16 sm:py-24 relative overflow-hidden">
  
  {/* Ambient Cosmic Purple & Amber Glow */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-[radial-gradient(circle,rgba(245,158,11,0.12)_0%,rgba(109,40,217,0.14)_45%,transparent_70%)] blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold uppercase tracking-wider mb-3 shadow-[0_0_20px_rgba(245,158,11,0.15)]">
        <span>🔥 Vedic Shorts & Daily Inspiration</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black font-cinzel text-white tracking-wide">
        Brahmacharya <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-500">Prerna Reels</span>
      </h2>

      <p class="mt-3 text-xs sm:text-sm text-zinc-400 leading-relaxed">
        Short, potent bursts of Brahmacharya wisdom, motivational reminders, and celibacy teachings to fuel your daily Tapasya.
      </p>
    </div>

    <!-- Outer Phone Glow Frame -->
    <div class="relative group">
      <div class="absolute -inset-1.5 bg-gradient-to-b from-amber-500/30 via-indigo-500/20 to-amber-500/30 rounded-[2.5rem] blur-lg opacity-70 group-hover:opacity-100 transition duration-500 pointer-events-none"></div>

      <div class="relative w-[340px] xs:w-[380px] h-[680px] rounded-[2rem] bg-zinc-950 border-2 border-amber-500/40 shadow-[0_0_50px_rgba(0,0,0,0.9),0_0_30px_rgba(245,158,11,0.2)] p-2.5 flex flex-col overflow-hidden">
        
        <!-- Header bar -->
        <div class="w-full flex items-center justify-between px-3 py-1.5 border-b border-zinc-800/80 mb-2 shrink-0">
          <div class="flex items-center gap-1.5 text-[11px] font-bold text-amber-300">
            <span>✨ Prerna Feed</span>
          </div>
          <span class="text-[10px] text-zinc-500 font-mono tracking-wider">
            @brahmacharyahelp
          </span>
        </div>

        <!-- Vertical Swipable Reel Container -->
        <div class="w-full flex-1 overflow-y-scroll snap-y snap-mandatory rounded-2xl bg-zinc-900 border border-zinc-800 shadow-2xl no-scrollbar space-y-4 p-2">
          
          <!-- Reel 1 -->
          <div class="snap-start w-full h-[640px] flex items-center justify-center relative rounded-xl overflow-hidden bg-black border border-zinc-800">
            <script async src="https://telegram.org/js/telegram-widget.js?22" 
                    data-telegram-post="brahmacharyahelp/637" 
                    data-width="100%"></script>
          </div>

          <!-- Nayi Reel Add Karne Ke Liye Bas Naya Post Number Change Karke Paste Karo -->
          <!--
          <div class="snap-start w-full h-[640px] flex items-center justify-center relative rounded-xl overflow-hidden bg-black border border-zinc-800">
            <script async src="https://telegram.org/js/telegram-widget.js?22" 
                    data-telegram-post="brahmacharyahelp/638" 
                    data-width="100%"></script>
          </div>
          -->

        </div>

        <!-- Bottom hint -->
        <div class="pt-2 flex items-center justify-between px-2 text-[11px] text-zinc-400 shrink-0">
          <span class="text-[10px] text-zinc-500 flex items-center gap-1">
            <span>↕</span> Swipe up for next reel
          </span>
          <span class="text-[10px] text-amber-400/80 font-mono">
            1 Reel Loaded
          </span>
        </div>

      </div>
    </div>

    <!-- Direct Telegram Channel Link -->
    <div class="mt-8 text-center">
      <a
        href="https://t.me/brahmacharyahelp"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-zinc-900/80 hover:bg-zinc-800 border border-amber-500/30 hover:border-amber-400 text-xs font-bold text-amber-300 hover:text-amber-200 transition shadow-sm group cursor-pointer"
      >
        <span>Explore All Reels on Telegram (@brahmacharyahelp)</span>
        <span class="text-amber-400 group-hover:translate-x-0.5 transition-transform">↗</span>
      </a>
    </div>

  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
