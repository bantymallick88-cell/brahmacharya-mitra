        >
          <source src="https://example.com/reel3.mp4" type="video/mp4" />
        </video>
        
        <div class="absolute bottom-6 left-4 right-4 flex justify-between items-end z-10 pointer-events-none">
          <div class="pointer-events-auto bg-black/60 backdrop-blur-md p-3.5 rounded-2xl border border-white/10 w-full shadow-lg">
