---
import Layout from '../layouts/Layout.astro';
import { Compass, Home, Sparkles, ArrowLeft, Shield } from 'lucide-react';

const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
---

<Layout 
  title="404 - Page Not Found — Brahmacharya Mitra"
  description="The sacred path you are looking for does not exist or has been moved. Return to the Brahmacharya Mitra home sanctuary."
>
  <main class="min-h-screen bg-[#02040a] text-zinc-100 flex items-center justify-center px-4 py-16 relative overflow-hidden selection:bg-amber-400 selection:text-black">
    
    {/* Ambient Cosmic Mahadev Aura */}
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(245,158,11,0.16)_0%,rgba(109,40,217,0.18)_35%,rgba(2,4,10,0.9)_70%)] blur-3xl pointer-events-none"></div>

    <div class="max-w-xl w-full text-center relative z-10 space-y-8 p-8 sm:p-12 rounded-3xl bg-zinc-950/80 border border-amber-500/30 backdrop-blur-2xl shadow-[0_0_60px_rgba(245,158,11,0.2)]">
      
      {/* Divine ॐ Emblem */}
      <div class="relative inline-block">
        <div class="w-20 h-20 sm:w-24 sm:h-24 mx-auto rounded-3xl divine-emblem flex items-center justify-center text-amber-300 font-cinzel font-black text-3xl sm:text-4xl shadow-[0_0_35px_rgba(245,158,11,0.4)] border border-amber-400/50 animate-pulse">
          ॐ
        </div>
        <div class="absolute -top-2 -right-2 px-2.5 py-0.5 rounded-full bg-amber-500/20 border border-amber-500/50 text-amber-300 text-[10px] font-bold tracking-widest uppercase">
          Marga
        </div>
      </div>

      {/* Main 404 Heading */}
      <div class="space-y-3">
        <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold uppercase tracking-wider">
          <Compass class="w-3.5 h-3.5 text-amber-400" />
          <span>Path Diverged</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-black font-cinzel text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-amber-100 tracking-tight">
          404 - Page Not Found
        </h1>

        <p class="text-zinc-300 text-sm sm:text-base leading-relaxed max-w-md mx-auto">
          The sacred page you are searching for does not exist, has dissolved into the cosmos, or has been relocated.
        </p>

        <p class="text-xs text-amber-400/80 font-sanskrit italic">
          “योगश्चित्तवृत्तिनिरोधः — When the mind wanders, bring it back to its center.”
        </p>
      </div>

      {/* Action Navigation */}
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a 
          href="./"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3 rounded-2xl bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-zinc-950 font-black text-sm transition-all duration-300 shadow-[0_0_25px_rgba(245,158,11,0.35)] hover:shadow-[0_0_35px_rgba(245,158,11,0.55)] hover:scale-105 active:scale-95 cursor-pointer"
        >
          <Home class="w-4 h-4 fill-black" />
          <span>Return to Home</span>
        </a>

        <button 
          onclick="history.back()"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-700 hover:border-amber-400/50 text-zinc-300 hover:text-white font-bold text-xs transition cursor-pointer"
        >
          <ArrowLeft class="w-3.5 h-3.5 text-amber-400" />
          <span>Go Back</span>
        </button>
      </div>

      {/* Spiritual Encouragement */}
      <div class="pt-4 border-t border-zinc-800/80 text-[11px] text-zinc-500 flex items-center justify-center gap-2">
        <Shield class="w-3.5 h-3.5 text-amber-500/70" />
        <span>Your streak data and progress remain 100% safe on your local device.</span>
      </div>

    </div>
  </main>
</Layout>
