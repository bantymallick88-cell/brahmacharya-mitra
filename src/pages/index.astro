---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Hero from '../components/Hero';
import PanicModal from '../components/PanicModal';
import BrainFogModal from '../components/BrainFogModal';
import CalculatorModal from '../components/CalculatorModal';
import PrivacyModal from '../components/PrivacyModal';
import InstallPrompt from '../components/InstallPrompt';
import Dashboard from '../components/Dashboard';
import OnboardingWizard from '../components/OnboardingWizard';
import PaymentModal from '../components/PaymentModal';
import DonationSection from '../components/DonationSection';
import BookRecommendations from '../components/BookRecommendations';
import FAQ from '../components/FAQ';
import SEO from '../components/SEO.tsx';
import Footer from '../components/Footer';

const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
---

<Layout 
	title="Brahmacharya Mitra — Celibacy, NoFap & Semen Retention Tracker"
	description="Overcome porn addiction, brain fog, and relapse cycles with Brahmacharya Mitra. Track your celibacy & NoFap streak, master semen retention, and transmute energy."
>
	<!-- SEO Metadata & Schema Component -->
	<SEO client:load />

	<!-- Fixed Header Navbar & Drawer -->
	<Header client:load />

	<!-- Global Onboarding Setup Wizard (Automatic on 1st visit & on-demand) -->
	<OnboardingWizard client:load />

	<!-- Add to Home Screen PWA Install Prompt -->
	<InstallPrompt client:load />

	<!-- Fullscreen Emergency Panic Shield Modal (Triggerable anywhere) -->
	<PanicModal client:load />

	<!-- Fullscreen Brain Fog Diagnostic Modal (Triggerable from Navigation Drawer) -->
	<BrainFogModal client:load />

	<!-- Fullscreen Relapse Cost Calculator Modal (Triggerable from Navigation Drawer) -->
	<CalculatorModal client:load />

	<!-- Fullscreen Privacy Policy & Data Sovereignty Modal (Triggerable anywhere) -->
	<PrivacyModal client:load />

	<!-- Fullscreen UPI Instant Seva Payment Modal (Triggerable anywhere) -->
	<PaymentModal client:load />

	<!-- Clean Landing Page: Strictly focused on Streak Counter, Habit Carousel & Books -->
	<main class="flex-1 w-full max-w-full overflow-x-hidden">
		<!-- Clean Landing Hero Section -->
		<Hero client:load />

		<!-- Core Sadhana Navigation Highlights: Dashboard, Leaderboard & Setup -->
		<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 sm:-mt-10 mb-12 relative z-20">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
				<!-- Card 1: Daily Dashboard -->
				<a
					href={baseUrl + "dashboard/"}
					class="group relative overflow-hidden rounded-3xl bg-gradient-to-b from-zinc-900/90 to-zinc-950 border border-amber-500/30 hover:border-amber-400 p-6 backdrop-blur-xl shadow-2xl transition-all duration-300 hover:scale-[1.02] flex flex-col justify-between"
				>
					<div class="absolute top-0 right-0 w-32 h-32 bg-amber-500/10 rounded-full blur-2xl pointer-events-none group-hover:bg-amber-500/20 transition-all" />
					<div>
						<div class="flex items-center justify-between mb-4">
							<div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-2xl shadow-inner">
								🧭
							</div>
							<span class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-300 border border-amber-500/30">
								Live Dial
							</span>
						</div>
						<h3 class="text-lg font-black text-white group-hover:text-amber-300 transition-colors">
							Daily Sadhana Dashboard
						</h3>
						<p class="text-xs text-zinc-400 mt-1 leading-relaxed">
							Speedometer progress dial, morning/afternoon/night dinacharya checklists, and digital 108 Japa Mala.
						</p>
					</div>
					<div class="mt-4 pt-3 border-t border-zinc-800/80 flex items-center justify-between text-xs font-bold text-amber-400 group-hover:text-amber-300">
						<span>Open Daily Dashboard</span>
						<span class="group-hover:translate-x-1 transition-transform">→</span>
					</div>
				</a>

				<!-- Card 2: Global Leaderboard -->
				<a
					href={baseUrl + "leaderboard/"}
					class="group relative overflow-hidden rounded-3xl bg-gradient-to-b from-zinc-900/90 to-zinc-950 border border-amber-500/30 hover:border-amber-400 p-6 backdrop-blur-xl shadow-2xl transition-all duration-300 hover:scale-[1.02] flex flex-col justify-between"
				>
					<div class="absolute top-0 right-0 w-32 h-32 bg-yellow-500/10 rounded-full blur-2xl pointer-events-none group-hover:bg-yellow-500/20 transition-all" />
					<div>
						<div class="flex items-center justify-between mb-4">
							<div class="w-12 h-12 rounded-2xl bg-yellow-500/10 border border-yellow-500/30 flex items-center justify-center text-2xl shadow-inner">
								🏆
							</div>
							<span class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-yellow-500/10 text-yellow-300 border border-yellow-500/30">
								Podium
							</span>
						</div>
						<h3 class="text-lg font-black text-white group-hover:text-amber-300 transition-colors">
							Global Sadhak Leaderboard
						</h3>
						<p class="text-xs text-zinc-400 mt-1 leading-relaxed">
							Top 3 Saffron Gold podium, filter by clean streak days or Naam Jap, and unite with sadhaks worldwide.
						</p>
					</div>
					<div class="mt-4 pt-3 border-t border-zinc-800/80 flex items-center justify-between text-xs font-bold text-amber-400 group-hover:text-amber-300">
						<span>View Global Ranks</span>
						<span class="group-hover:translate-x-1 transition-transform">→</span>
					</div>
				</a>

				<!-- Card 3: Setup Wizard -->
				<button
					onclick="window.dispatchEvent(new CustomEvent('open-onboarding-wizard'))"
					class="group relative overflow-hidden rounded-3xl bg-gradient-to-b from-zinc-900/90 to-zinc-950 border border-amber-500/30 hover:border-amber-400 p-6 backdrop-blur-xl shadow-2xl transition-all duration-300 hover:scale-[1.02] flex flex-col justify-between text-left cursor-pointer"
				>
					<div class="absolute top-0 right-0 w-32 h-32 bg-amber-500/10 rounded-full blur-2xl pointer-events-none group-hover:bg-amber-500/20 transition-all" />
					<div>
						<div class="flex items-center justify-between mb-4">
							<div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-2xl shadow-inner">
								✨
							</div>
							<span class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-300 border border-amber-500/30">
								Interactive
							</span>
						</div>
						<h3 class="text-lg font-black text-white group-hover:text-amber-300 transition-colors">
							Setup Wizard & Goals
						</h3>
						<p class="text-xs text-zinc-400 mt-1 leading-relaxed">
							Configure your profile, country flag, target days (21, 60, 90, 108), and customized daily routines.
						</p>
					</div>
					<div class="mt-4 pt-3 border-t border-zinc-800/80 flex items-center justify-between text-xs font-bold text-amber-400 group-hover:text-amber-300">
						<span>Configure Profile & Target</span>
						<span class="group-hover:translate-x-1 transition-transform">→</span>
					</div>
				</button>
			</div>
		</section>

		<!-- Animated Circular Streak Timer & Daily Habit Transformation Carousel -->
		<Dashboard client:load />

		<!-- Essential Books & Scripture Studies -->
		<BookRecommendations client:visible />

		<!-- Brahmacharya Seva & Web Development Contribution Section -->
		<DonationSection client:visible />

		<!-- FAQ Section -->
		<section id="faq-section" class="py-12 px-4 max-w-4xl mx-auto">
			<FAQ client:visible />
		</section>
	</main>

	<!-- Footer -->
	<Footer client:visible />

	<!-- Floating Emergency Panic FAB for instant access on any screen -->
	<div class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40 max-w-[calc(100vw-2rem)]">
		<button
			id="floating-panic-btn"
			onclick="window.dispatchEvent(new CustomEvent('open-panic-modal'))"
			class="btn-shimmer flex items-center gap-2 px-3.5 py-2.5 sm:px-4.5 sm:py-3 rounded-full backdrop-blur-xl bg-zinc-950/90 hover:bg-zinc-900 border border-red-500/50 hover:border-amber-400 text-white font-black text-xs sm:text-sm tracking-wide shadow-[0_0_25px_rgba(239,68,68,0.35),0_0_15px_rgba(245,158,11,0.15)] hover:shadow-[0_0_35px_rgba(245,158,11,0.45)] hover:scale-105 active:scale-95 transition-all duration-300 cursor-pointer group whitespace-nowrap"
			aria-label="Emergency Panic Mode"
		>
			<span class="relative flex h-2.5 w-2.5 sm:h-3 sm:w-3">
				<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75"></span>
				<span class="relative inline-flex rounded-full h-2.5 w-2.5 sm:h-3 sm:w-3 bg-red-400 group-hover:bg-amber-400 transition-colors"></span>
			</span>
			<span class="text-zinc-100 group-hover:text-amber-200 transition-colors font-bold tracking-wider">🚨 Panic Mode</span>
		</button>
	</div>
</Layout>
