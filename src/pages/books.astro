---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import LibraryView from '../components/LibraryView';
import OnboardingWizard from '../components/OnboardingWizard';
import PanicModal from '../components/PanicModal';

import Footer from '../components/Footer';
import SEO from '../components/SEO.tsx';
---

<Layout 
	title="Sacred Library & Books (29+ PDFs) — Brahmacharya Mitra"
	description="Explore 29+ free authentic books and research papers on Brahmacharya, celibacy, neuroscience, mind mastery, and Vedic scriptures in Hindi and English."
>
	<!-- SEO Metadata & Schema -->
	<SEO client:load />

	<!-- Fixed Header Navbar & Drawer -->
	<Header client:load />

	<!-- Onboarding Setup Wizard -->
	<OnboardingWizard client:load />

	<!-- Emergency Panic Modal Shield -->
	<PanicModal client:load />

	<!-- Main Content: Library View -->
	<main class="main-content-container flex-1 w-full min-h-screen pt-20 pb-28 bg-[#0c0908] overflow-y-visible">
		<LibraryView client:load />



	</main>

	<!-- Footer -->
	<Footer client:visible />
</Layout>
