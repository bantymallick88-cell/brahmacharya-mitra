---
import Layout from '../layouts/Layout.astro';
import { 
  ShieldCheck, 
  Lock, 
  HardDrive, 
  EyeOff, 
  Database, 
  HeartHandshake, 
  ArrowLeft, 
  Download, 
  CheckCircle2, 
  Sparkles,
  FileText
} from 'lucide-react';

const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
const lastUpdated = "October 27, 2026";
---

<Layout 
  title="Privacy Policy & Data Security — Brahmacharya Mitra"
  description="Our sacred commitment to your absolute privacy. 100% client-side storage, zero trackers, zero data selling. Your recovery from addiction is private and protected."
>
  <main class="min-h-screen bg-[#02040a] text-zinc-100 py-12 px-4 sm:px-6 lg:px-8 selection:bg-amber-400 selection:text-black relative overflow-x-hidden">
    
    {/* Ambient Glows */}
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-[radial-gradient(circle,rgba(245,158,11,0.12)_0%,rgba(109,40,217,0.08)_40%,transparent_70%)] blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto relative z-10 space-y-10">
      
      {/* Navigation Top Bar */}
      <div class="flex items-center justify-between border-b border-zinc-800/80 pb-6">
        <a 
          href={baseUrl}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-zinc-950/80 border border-zinc-800 hover:border-amber-500/50 text-xs font-bold text-zinc-300 hover:text-white transition group"
        >
          <ArrowLeft class="w-4 h-4 text-amber-400 group-hover:-translate-x-1 transition-transform" />
          <span>Back to Brahmacharya Mitra</span>
        </a>

        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-semibold">
          <CheckCircle2 class="w-3.5 h-3.5" />
          <span>100% Client-Side Private</span>
        </div>
      </div>

      {/* Hero Header */}
      <div class="text-center space-y-4 pt-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold uppercase tracking-wider">
          <ShieldCheck class="w-4 h-4 text-amber-400" />
          <span>Sacred Trust & Data Sovereignty</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black font-cinzel text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-amber-100 tracking-tight">
          Privacy Policy
        </h1>

        <p class="text-zinc-400 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          Brahmacharya Mitra was built with a fundamental principle: your battle against lust, pornography addiction, and mental weakness is holy and strictly personal.
        </p>

        <div class="text-xs text-zinc-500">
          Last Updated: <span class="text-zinc-400 font-semibold">{lastUpdated}</span> • Applies to all users worldwide
        </div>
      </div>

      {/* Main Policy Card Container */}
      <div class="p-6 sm:p-10 rounded-3xl bg-zinc-950/80 border border-amber-500/25 space-y-8 backdrop-blur-xl shadow-[0_0_50px_rgba(245,158,11,0.12)]">
        
        {/* Section 1 */}
        <section class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl divine-emblem flex items-center justify-center text-amber-300">
              <HardDrive class="w-4 h-4" />
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-white">
              1. 100% Local Device Storage (No Central Database)
            </h2>
          </div>
          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed pl-11">
            Unlike commercial addiction recovery apps that require user email signups, phone numbers, and cloud database syncs, 
            <strong> Brahmacharya Mitra does not have a central user database.</strong> Every streak day record, relapse log, journal entry, 
            emergency contact note, and meditation timer history is stored exclusively in your browser's <code class="text-amber-300 bg-zinc-900 px-1.5 py-0.5 rounded">localStorage</code> on your physical device. 
            We have zero technical capability to view, read, or sell your data.
          </p>
        </section>

        {/* Section 2 */}
        <section class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl divine-emblem flex items-center justify-center text-amber-300">
              <EyeOff class="w-4 h-4" />
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-white">
              2. Zero Third-Party Advertising & No User Profiling
            </h2>
          </div>
          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed pl-11">
            We reject the surveillance capitalism model. We do not inject behavioral ad networks (such as Google AdSense, Taboola, or Outbrain), 
            nor do we install cross-site trackers (such as Meta Facebook Pixel or TikTok trackers). You will never see commercial banner advertisements 
            or receive targeted ads based on your visit to this spiritual platform.
          </p>
        </section>

        {/* Section 3 */}
        <section class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl divine-emblem flex items-center justify-center text-amber-300">
              <Database class="w-4 h-4" />
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-white">
              3. Device Hardware & Permissions Policy
            </h2>
          </div>
          <div class="text-xs sm:text-sm text-zinc-300 leading-relaxed pl-11 space-y-2">
            <p>Our Progressive Web App (PWA) operates with minimal system interaction:</p>
            <ul class="list-disc pl-5 space-y-1.5 text-zinc-400">
              <li><strong class="text-zinc-200">Microphone & Camera:</strong> Brahmacharya Mitra never requests or accesses your microphone, webcam, or mobile camera.</li>
              <li><strong class="text-zinc-200">Sensors & Vibration:</strong> The vibration API is invoked exclusively during the Pranayama / Meditative breathing session to provide rhythmic haptic cues for breath retention.</li>
              <li><strong class="text-zinc-200">Offline Caching:</strong> Service Workers cache application assets (HTML, CSS, JS, audio) locally on your device for rapid offline loading.</li>
            </ul>
          </div>
        </section>

        {/* Section 4 */}
        <section class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl divine-emblem flex items-center justify-center text-amber-300">
              <HeartHandshake class="w-4 h-4" />
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-white">
              4. Affiliate Disclosure (Amazon & Flipkart Associates)
            </h2>
          </div>
          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed pl-11">
            In compliance with the Federal Trade Commission (FTC) and global consumer protection standards, we disclose that certain outbound links in our Recommended Literature section contain affiliate tracking tags (such as Amazon Associates). 
            When you purchase a scripture or scientific study through these links, we may earn a modest commission at <strong>absolutely zero additional cost to you</strong>. 
            100% of these commissions are deployed to pay our domain, hosting, and AI token infrastructure costs so the app remains free for millions of young men.
          </p>
        </section>

        {/* Section 5 */}
        <section class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl divine-emblem flex items-center justify-center text-amber-300">
              <Lock class="w-4 h-4" />
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-white">
              5. Right to Data Portability & Instant Erasure
            </h2>
          </div>
          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed pl-11">
            You own 100% of your data. Under GDPR, CCPA, and global privacy standards:
          </p>
          <ul class="list-disc pl-16 space-y-1.5 text-xs sm:text-sm text-zinc-400">
            <li><strong>Export:</strong> You can download a complete JSON backup of your streaks and journals at any moment directly from the Settings menu.</li>
            <li><strong>Erasure:</strong> You can permanently wipe all records in one click by selecting "Reset All Data" in Settings, or by clearing your browser's site data. No trace remains on any server.</li>
          </ul>
        </section>

        {/* Section 6 */}
        <section class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl divine-emblem flex items-center justify-center text-amber-300">
              <FileText class="w-4 h-4" />
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-white">
              6. Medical & Psychological Disclaimer
            </h2>
          </div>
          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed pl-11">
            Brahmacharya Mitra is a spiritual, philosophical, and personal habit discipline tool grounded in ancient Vedic wisdom and modern neuroplasticity research. It is not intended to replace professional psychiatric consultation, clinical psychotherapy, or medical diagnosis. If you are struggling with severe psychiatric disorders or clinical depression, please consult a qualified healthcare provider.
          </p>
        </section>

        {/* Seva Commitment Footer Box */}
        <div class="pt-6 border-t border-zinc-800/80 text-center space-y-4">
          <div class="inline-flex items-center gap-2 text-amber-300 font-cinzel font-bold text-sm">
            <Sparkles class="w-4 h-4 text-amber-400" />
            <span>सत्यमेव जयते नानृतम् — Truth Alone Triumphs</span>
          </div>
          <p class="text-xs text-zinc-400 max-w-xl mx-auto">
            Questions regarding our privacy framework or open-source seva? You may contact our seva collective via our community links or GitHub repository.
          </p>
          <div class="pt-2">
            <a 
              href={baseUrl}
              class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-zinc-950 font-black text-xs transition shadow-lg hover:scale-105"
            >
              <span>Return to Dashboard</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </main>
</Layout>
