---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import DailyDashboard from '../components/DailyDashboard';
import OnboardingWizard from '../components/OnboardingWizard';
import PanicModal from '../components/PanicModal';

import Footer from '../components/Footer';
import SEO from '../components/SEO.tsx';
---

<Layout 
	title="Daily Sadhana Dashboard — Brahmacharya Mitra"
	description="Track your daily celibacy streak velocity, daily morning/afternoon/night dinacharya routines, and sacred Naam Jap Mala counter."
>
	<!-- SEO Metadata & Schema -->
	<SEO client:load />

	<!-- Fixed Header Navbar & Drawer -->
	<Header client:load />

	<!-- Onboarding Setup Wizard (Accessible anytime to tune goals/routines) -->
	<OnboardingWizard client:load />

	<!-- Emergency Panic Modal Shield -->
	<PanicModal client:load />

	<!-- Main Content: Daily Progress Dashboard & Seva Section -->
	<main class="main-content-container flex-1 w-full min-h-screen pt-20 pb-28 bg-[#0c0908] overflow-y-visible">
		<DailyDashboard client:load />



	</main>

	<!-- Footer -->
	<Footer client:visible />
</Layout>
